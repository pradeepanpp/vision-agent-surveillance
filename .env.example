# .env.example
# ─────────────────────────────────────────────
# Copy to .env and fill in your values.
# Never commit .env to GitHub.
# ─────────────────────────────────────────────

# Required — OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional — model settings
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.1
MAX_TOKENS=500

# Optional — surveillance settings
ALERT_COOLDOWN_SECONDS=30   # Min seconds between LLM calls
LOG_ALERTS=true             # Write alerts to logs/alerts.jsonl